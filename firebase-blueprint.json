          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "userId", "admissionNo", "rollNo", "fullName", "username", "classId", "className", "sectionId", "sectionName", "status", "createdAt", "updatedAt"]
    },
