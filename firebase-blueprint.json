  "firestore": {
    "/admins/{adminUid}": {
      "schema": { "$ref": "#/entities/AdminMarker" },
      "description": "Trusted administrator UID registry."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserAccount" },
      "description": "Core user authentication and role metadata."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Isolated PII subcollection for phone, address, and personal bio."
    },
    "/students/{studentId}": {
      "schema": { "$ref": "#/entities/StudentRecord" },
      "description": "Student academic directory."
    },
    "/teachers/{teacherId}": {
      "schema": { "$ref": "#/entities/TeacherRecord" },
      "description": "Teacher academic directory and assignments."
    },
    "/classes/{classId}": {
      "schema": { "$ref": "#/entities/SchoolClass" },
      "description": "School class registry."
    },
    "/sections/{sectionId}": {
      "schema": { "$ref": "#/entities/ClassSection" },
      "description": "Class section registry."
    },
    "/subjects/{subjectId}": {
      "schema": { "$ref": "#/entities/AcademicSubject" },
      "description": "Curriculum subjects registry."
    },
    "/examinations/{examId}": {
      "schema": { "$ref": "#/entities/Examination" },
      "description": "School examinations schedule and grading parameters."
    },
    "/marks/{markId}": {
      "schema": { "$ref": "#/entities/MarkRecord" },
      "description": "Student examination marks and calculated grades."
    },
    "/schoolSettings/{settingId}": {
      "schema": { "$ref": "#/entities/SchoolSettings" },
      "description": "School branding and contact metadata."
    },
    "/appSettings/{settingId}": {
      "schema": { "$ref": "#/entities/AppSettings" },
      "description": "Application theme and grading configuration."
    },
    "/activityLogs/{logId}": {
      "schema": { "$ref": "#/entities/ActivityLog" },
      "description": "Administrative and academic audit log."
    },
    "/campusIndex/{docId}": {
      "schema": { "$ref": "#/entities/CampusIndex" },
      "description": "Administrator document ID manifest for deterministic Firestore hydration."
    }
  }
}
