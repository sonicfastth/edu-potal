    "CampusIndex": {
      "title": "CampusIndex",
      "description": "Administrator manifest of document IDs across campus collections for fast deterministic hydration.",
      "type": "object",
      "properties": {
        "userIds": {
          "type": "array"
        },
        "studentIds": {
          "type": "array"
        },
        "teacherIds": {
          "type": "array"
        },
        "classIds": {
          "type": "array"
        },
        "sectionIds": {
          "type": "array"
