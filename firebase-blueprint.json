        "rollNo": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20
        },
        "fullName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "username": {
          "type": "string",
          "minLength": 3,
          "maxLength": 64
        },
        "classId": {
          "type": "string",
          "maxLength": 128
        },
        "className": {
          "type": "string",
          "maxLength": 80
