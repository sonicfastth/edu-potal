{
  "entities": {
    "AdminMarker": {
      "title": "AdminMarker",
      "description": "Trusted marker document identifying an administrator account by UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "username": {
          "type": "string",
          "maxLength": 64
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "username", "createdAt"]
    },
    "UserAccount": {
      "title": "UserAccount",
      "description": "Core user authentication and role mapping without raw PII.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "username": {
          "type": "string",
          "minLength": 3,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_.\\-]+$"
        },
        "role": {
          "type": "string",
          "enum": ["admin", "teacher", "student"]
        },
        "fullName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "avatarUrl": {
          "type": "string",
          "maxLength": 2048
        },
        "mustChangePassword": {
          "type": "boolean"
        },
        "linkedEntityId": {
          "type": "string",
          "maxLength": 128
        },
        "passwordHash": {
          "type": "string",
          "maxLength": 256
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "username", "role", "fullName", "mustChangePassword", "createdAt", "updatedAt"]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Isolated PII subcollection document for phone number, address, and personal details.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "phone": {
          "type": "string",
          "maxLength": 40
        },
        "address": {
          "type": "string",
          "maxLength": 300
        },
        "guardianName": {
          "type": "string",
          "maxLength": 120
        },
        "dateOfBirth": {
          "type": "string",
          "maxLength": 32
        },
        "bloodGroup": {
          "type": "string",
          "maxLength": 16
        },
        "bio": {
          "type": "string",
          "maxLength": 500
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "phone", "address", "updatedAt"]
    },
    "StudentRecord": {
      "title": "StudentRecord",
